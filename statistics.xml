<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_statistics</name>
    <version>1.0.0</version>
    <creationDate>20.08.2026</creationDate>
    <author>Michael Buchholz</author>
    <authorEmail>mail@lean-stack.rocks</authorEmail>
    <copyright>Weltspiegel Cottbus</copyright>
    <license>MIT</license>
    <description>PLG_SYSTEM_STATISTICS_XML_DESCRIPTION</description>
    <namespace path="src">Weltspiegel\Plugin\System\Statistics</namespace>

    <files>
        <folder plugin="statistics">services</folder>
        <folder>src</folder>
    </files>

    <languages folder="language">
        <language tag="de-DE">de-DE/plg_system_statistics.ini</language>
        <language tag="de-DE">de-DE/plg_system_statistics.sys.ini</language>
        <language tag="en-GB">en-GB/plg_system_statistics.ini</language>
        <language tag="en-GB">en-GB/plg_system_statistics.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                        name="metrics"
                        type="metrics"
                        addfieldprefix="Weltspiegel\Plugin\System\Statistics\Field"
                        default="width,pointer"
                        label="PLG_SYSTEM_STATISTICS_FIELD_METRICS_LABEL"
                        description="PLG_SYSTEM_STATISTICS_FIELD_METRICS_DESC"
                />
                <field
                        name="exclude_logged_in"
                        type="radio"
                        layout="joomla.form.field.radio.switcher"
                        default="1"
                        label="PLG_SYSTEM_STATISTICS_FIELD_EXCLUDE_LABEL"
                        description="PLG_SYSTEM_STATISTICS_FIELD_EXCLUDE_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
